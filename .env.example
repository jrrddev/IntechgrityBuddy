# Turso Database (leave file:local.db for local development, or use your Turso libsql:// URL)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Session signing secret (change in production!)
JWT_SECRET=intechgrity-buddy-dev-secret-key-2026

# Default Admin account created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Free AI Provider: gemini | groq | openrouter
AI_PROVIDER=gemini

# Free API Keys (can also be configured live in the Admin Dashboard)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

